        }
        lines {
          text: "const J2 = 1.08262668e-3; // Earth J2 oblateness harmonic"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "const SECONDS_PER_DAY = 86400;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "const TWO_PI = 2 * Math.PI;"
