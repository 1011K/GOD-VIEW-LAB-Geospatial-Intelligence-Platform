        }
        lines {
          text: "    const footprintRadiusKm = earthRadiusKm * horizonAngle;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Mean motion from TLE line 2 (revolutions per day, columns 53-63)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    let periodMinutes = 90;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    try {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      const meanMotion = parseFloat(sat.line2.substring(52, 63));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      if (!isNaN(meanMotion) && meanMotion > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        periodMinutes = (24 * 60) / meanMotion;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    } catch {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      // fallback calculation"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Inclination from TLE line 2 (columns 9-16)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    let inclinationDeg = 51.6;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    try {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      const inc = parseFloat(sat.line2.substring(8, 16));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      if (!isNaN(inc)) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        inclinationDeg = inc;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    } catch {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      // fallback"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const tle = parseTLE(sat.line1, sat.line2);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!tle) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Time difference from epoch in seconds"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const deltaTSeconds = (date.getTime() - tle.epochDate.getTime()) / 1000;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Mean motion n in radians/sec"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const n = (tle.meanMotionRevPerDay * TWO_PI) / SECONDS_PER_DAY;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Semi-major axis a (km)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const a = Math.pow(EARTH_MU_KM3_S2 / Math.pow(n, 2), 1 / 3);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Semi-latus rectum p"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const p = a * (1 - Math.pow(tle.eccentricity, 2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Inclination, RAAN, Argument of Perigee in radians"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const incRad = tle.inclinationDeg * DEG_TO_RAD;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const argPerigeeRad = tle.argPerigeeDeg * DEG_TO_RAD;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // J2 Nodal Precession of RAAN (rad/s) and apsidal precession of arg perigee"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const dOmega = -1.5 * J2 * Math.pow(EARTH_RADIUS_KM / Math.max(1, p), 2) * n * Math.cos(incRad);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const dOmegaAps = 0.75 * J2 * Math.pow(EARTH_RADIUS_KM / Math.max(1, p), 2) * n * (5 * Math.pow(Math.cos(incRad), 2) - 1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const raanRad = (tle.raanDeg * DEG_TO_RAD + dOmega * deltaTSeconds) % TWO_PI;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const omegaRad = (argPerigeeRad + dOmegaAps * deltaTSeconds) % TWO_PI;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Mean anomaly at target time"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const meanAnomalyRad = ((tle.meanAnomalyDeg * DEG_TO_RAD + n * deltaTSeconds) % TWO_PI + TWO_PI) % TWO_PI;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Eccentric Anomaly E"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const E = solveKepler(meanAnomalyRad, tle.eccentricity);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // True Anomaly nu"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const sinNu = (Math.sqrt(1 - Math.pow(tle.eccentricity, 2)) * Math.sin(E)) / (1 - tle.eccentricity * Math.cos(E));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const cosNu = (Math.cos(E) - tle.eccentricity) / (1 - tle.eccentricity * Math.cos(E));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const nu = Math.atan2(sinNu, cosNu);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Radius r (km)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const r = a * (1 - tle.eccentricity * Math.cos(E));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Position in orbital plane"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const u = omegaRad + nu; // Argument of latitude"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const xOrb = r * Math.cos(u);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const yOrb = r * Math.sin(u);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Coordinate conversion to Earth-Centered Inertial (ECI)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const xEci = xOrb * Math.cos(raanRad) - yOrb * Math.cos(incRad) * Math.sin(raanRad);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const yEci = xOrb * Math.sin(raanRad) + yOrb * Math.cos(incRad) * Math.cos(raanRad);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const zEci = yOrb * Math.sin(incRad);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Instantaneous Orbital Velocity (vis-viva equation)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const velocityKmS = Math.sqrt(Math.max(0, EARTH_MU_KM3_S2 * (2 / r - 1 / a)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Greenwich Mean Sidereal Time"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const gmst = calculateGMST(date);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Earth-Centered Earth-Fixed (ECEF) rotation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const xEcef = xEci * Math.cos(gmst) + yEci * Math.sin(gmst);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const yEcef = -xEci * Math.sin(gmst) + yEci * Math.cos(gmst);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const zEcef = zEci;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Geodetic Latitude, Longitude, Altitude (WGS-84 Bowring algorithm)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const lonRad = Math.atan2(yEcef, xEcef);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const pEcef = Math.sqrt(xEcef * xEcef + yEcef * yEcef);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let latRad = Math.atan2(zEcef, pEcef * (1 - Math.pow(1 - EARTH_FLATTENING, 2)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let i = 0; i < 4; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const sinLat = Math.sin(latRad);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const N = EARTH_RADIUS_KM / Math.sqrt(1 - (2 * EARTH_FLATTENING - Math.pow(EARTH_FLATTENING, 2)) * sinLat * sinLat);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      latRad = Math.atan2(zEcef + (2 * EARTH_FLATTENING - Math.pow(EARTH_FLATTENING, 2)) * N * sinLat, pEcef);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const sinLatFinal = Math.sin(latRad);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const NFinal = EARTH_RADIUS_KM / Math.sqrt(1 - (2 * EARTH_FLATTENING - Math.pow(EARTH_FLATTENING, 2)) * sinLatFinal * sinLatFinal);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const altitudeKm = Math.max(100, pEcef / Math.cos(latRad) - NFinal);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const latitude = latRad * RAD_TO_DEG;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let longitude = lonRad * RAD_TO_DEG;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Normalize longitude -180 to 180"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    while (longitude > 180) longitude -= 360;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    while (longitude < -180) longitude += 360;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Ground footprint calculation (geometric visibility horizon radius in km)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const horizonAngle = Math.acos(Math.min(0.999, EARTH_RADIUS_KM / (EARTH_RADIUS_KM + altitudeKm)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const footprintRadiusKm = EARTH_RADIUS_KM * horizonAngle;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const periodMinutes = (24 * 60) / tle.meanMotionRevPerDay;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      latitude: Number(latitude.toFixed(4)),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      longitude: Number(longitude.toFixed(4)),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      altitudeKm: Math.round(altitudeKm),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      velocityKmS: Number(velocityKmS.toFixed(2)),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      footprintRadiusKm: Math.round(footprintRadiusKm),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      periodMinutes: Number(periodMinutes.toFixed(1)),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      inclinationDeg: Number(inclinationDeg.toFixed(2))"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  } catch (err) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    console.error(`Error propagating satellite ${sat.name}:`, err);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      inclinationDeg: Number(tle.inclinationDeg.toFixed(2))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } catch (err) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    console.error(`Error in satellite propagator for ${sat.name}:`, err);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
