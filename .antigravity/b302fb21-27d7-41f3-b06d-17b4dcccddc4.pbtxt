  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import \"tailwindcss\";"
      replacement_content: "@import \"tailwindcss\";\n\n/* Custom Military / Tactical Theme & Leaflet Overrides */\n@layer utilities {\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n    height: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: rgba(2, 6, 23, 0.6);\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: rgba(6, 182, 212, 0.4);\n    border-radius: 2px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n    background: rgba(6, 182, 212, 0.8);\n  }\n}\n\n/* Tactical Leaflet Dark Styling */\n.leaflet-container {\n  background: #020617 !important;\n  font-family: \'JetBrains Mono\', monospace !important;\n}\n\n.tactical-map-tooltip {\n  background: rgba(2, 6, 23, 0.92) !important;\n  border: 1px solid rgba(6, 182, 212, 0.5) !important;\n  color: #f8fafc !important;\n  border-radius: 6px !important;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.7) !important;\n  backdrop-filter: blur(8px) !important;\n}\n\n.leaflet-tooltip-top:before {\n  border-top-color: rgba(6, 182, 212, 0.5) !important;\n}\n\n.leaflet-control-zoom {\n  border: 1px solid rgba(15, 23, 42, 0.8) !important;\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5) !important;\n  border-radius: 8px !important;\n  overflow: hidden !important;\n}\n\n.leaflet-control-zoom a {\n  background-color: rgba(2, 6, 23, 0.9) !important;\n  color: #38bdf8 !important;\n  border-bottom: 1px solid rgba(15, 23, 42, 0.8) !important;\n  transition: all 0.2s ease !important;\n}\n\n.leaflet-control-zoom a:hover {\n  background-color: rgba(8, 47, 73, 0.9) !important;\n  color: #e0f2fe !important;\n}\n"
    }
