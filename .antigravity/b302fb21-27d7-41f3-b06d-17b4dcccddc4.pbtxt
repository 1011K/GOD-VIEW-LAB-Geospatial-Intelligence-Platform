        }
        lines {
          text: "const RAD_TO_DEG = 180 / Math.PI;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "export interface ParsedTLE {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
