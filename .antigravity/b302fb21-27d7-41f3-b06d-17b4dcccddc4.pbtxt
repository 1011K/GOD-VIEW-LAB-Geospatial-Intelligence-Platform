  file_change {
    absolute_path_uri: "file:///src/components/TimelineScrubber.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Play, \n  Pause, \n  RotateCcw, \n  FastForward, \n  Rewind, \n  Clock, \n  Radio,\n  Calendar,\n  Zap\n} from \'lucide-react\';\n\ninterface TimelineScrubberProps {\n  currentSimTime: Date;\n  onTimeChange: (newTime: Date) => void;\n  isLive: boolean;\n  onResetToLive: () => void;\n  radarFrames?: Array<{ time: number; path: string }>;\n  onSelectRadarFrame?: (path: string) => void;\n}\n\nexport function TimelineScrubber({\n  currentSimTime,\n  onTimeChange,\n  isLive,\n  onResetToLive,\n  radarFrames = [],\n  onSelectRadarFrame\n}: TimelineScrubberProps) {\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [playbackSpeed, setPlaybackSpeed] = useState<number>(10); // 10x real-time\n\n  // Range: -24 hours to +6 hours from real current time\n  const now = new Date();\n  const minTime = now.getTime() - 24 * 3600 * 1000;\n  const maxTime = now.getTime() + 6 * 3600 * 1000;\n  const totalRange = maxTime - minTime;\n\n  // Playback timer\n  useEffect(() => {\n    if (!isPlaying) return;\n\n    const interval = setInterval(() => {\n      onTimeChange(new Date(currentSimTime.getTime() + playbackSpeed * 1000));\n    }, 100);\n\n    return () => clearInterval(interval);\n  }, [isPlaying, currentSimTime, playbackSpeed, onTimeChange]);\n\n  const handleSliderChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = parseFloat(e.target.value);\n    const targetMs = minTime + (val / 100) * totalRange;\n    onTimeChange(new Date(targetMs));\n    if (isPlaying) setIsPlaying(false);\n  };\n\n  const sliderPercent = Math.min(100, Math.max(0, ((currentSimTime.getTime() - minTime) / totalRange) * 100));\n\n  const stepHours = (hours: number) => {\n    onTimeChange(new Date(currentSimTime.getTime() + hours * 3600 * 1000));\n  };\n\n  return (\n    <div className=\"absolute bottom-3 left-1/2 -translate-x-1/2 z-20 w-[95%] max-w-4xl bg-slate-950/95 border border-cyan-950/80 rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl font-mono text-xs p-3 space-y-2.5 transition-all\">\n      {/* Top Bar: Timestamp and Status */}\n      <div className=\"flex items-center justify-between text-[11px]\">\n        <div className=\"flex items-center space-x-2\">\n          <Clock className=\"w-3.5 h-3.5 text-cyan-400\" />\n          <span className=\"text-slate-400 font-bold\">4D TIMELINE SIMULATION:</span>\n          <span className=\"font-bold text-slate-100 bg-slate-900 px-2 py-0.5 rounded border border-slate-800 text-cyan-300\">\n            {currentSimTime.toUTCString()}\n          </span>\n          <span className=\"text-[10px] text-slate-500\">\n            ({Math.round((currentSimTime.getTime() - now.getTime()) / 3600000)}h from now)\n          </span>\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          {isLive ? (\n            <span className=\"flex items-center space-x-1 px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-500/40 text-[10px] font-bold\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n              <span>LIVE TELEMETRY SYNC</span>\n            </span>\n          ) : (\n            <button\n              onClick={onResetToLive}\n              className=\"flex items-center space-x-1 px-2 py-0.5 rounded bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-bold text-[10px] transition-colors shadow\"\n            >\n              <RotateCcw className=\"w-3 h-3\" />\n              <span>SYNC TO REAL-TIME</span>\n            </button>\n          )}\n\n          {/* Speed Selector */}\n          <div className=\"flex items-center space-x-1 bg-slate-900 rounded p-0.5 border border-slate-800 text-[10px]\">\n            {[1, 10, 30, 60].map(speed => (\n              <button\n                key={speed}\n                onClick={() => setPlaybackSpeed(speed)}\n                className={`px-1.5 py-0.5 rounded transition-colors ${\n                  playbackSpeed === speed ? \'bg-cyan-500 text-slate-950 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                {speed}x\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Slider Bar */}\n      <div className=\"relative flex items-center space-x-3\">\n        <span className=\"text-[10px] text-slate-500 whitespace-nowrap\">-24h</span>\n        <div className=\"relative flex-1 flex items-center\">\n          <input\n            type=\"range\"\n            min=\"0\"\n            max=\"100\"\n            step=\"0.1\"\n            value={sliderPercent}\n            onChange={handleSliderChange}\n            className=\"w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400 hover:accent-cyan-300\"\n          />\n          {/* Real-time Marker Indicator (at 80% mark) */}\n          <div \n            className=\"absolute top-1/2 -translate-y-1/2 w-0.5 h-4 bg-emerald-500 pointer-events-none\"\n            style={{ left: `${((now.getTime() - minTime) / totalRange) * 100}%` }}\n            title=\"Real-time Now\"\n          />\n        </div>\n        <span className=\"text-[10px] text-slate-500 whitespace-nowrap\">+6h (Orbit Forecast)</span>\n      </div>\n\n      {/* Control Buttons */}\n      <div className=\"flex items-center justify-between pt-1 border-t border-slate-900\">\n        <div className=\"flex items-center space-x-1\">\n          <button\n            onClick={() => stepHours(-6)}\n            className=\"px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-slate-300 text-[10px] border border-slate-800 transition-colors\"\n          >\n            -6h\n          </button>\n          <button\n            onClick={() => stepHours(-1)}\n            className=\"px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-slate-300 text-[10px] border border-slate-800 transition-colors\"\n          >\n            -1h\n          </button>\n          <button\n            onClick={() => setIsPlaying(!isPlaying)}\n            className={`flex items-center space-x-1.5 px-3 py-1 rounded font-bold text-[11px] transition-all ${\n              isPlaying \n                ? \'bg-amber-500 hover:bg-amber-400 text-slate-950\' \n                : \'bg-cyan-600 hover:bg-cyan-500 text-slate-950\'\n            }`}\n          >\n            {isPlaying ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n            <span>{isPlaying ? \'PAUSE\' : \'PLAY SIMULATION\'}</span>\n          </button>\n          <button\n            onClick={() => stepHours(1)}\n            className=\"px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-slate-300 text-[10px] border border-slate-800 transition-colors\"\n          >\n            +1h\n          </button>\n          <button\n            onClick={() => stepHours(6)}\n            className=\"px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-slate-300 text-[10px] border border-slate-800 transition-colors\"\n          >\n            +6h\n          </button>\n        </div>\n\n        <div className=\"text-[10px] text-slate-400 flex items-center space-x-2\">\n          <span>Propagating SGP4 orbits & temporal hazard layers to specified Zulu epoch</span>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
