        lines {
          text: "        setSatellites(prevSats => prevSats.map(s => ({"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          ...s,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          calculated: calculateSatellitePosition(s, nextTime) || s.calculated"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        })));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
