          text: "                  <td className=\"p-3\">{f.origin_country}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <td className=\"p-3\">{f.baro_altitude_m}m ({Math.round(f.baro_altitude_m * 3.28084)}ft)</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <td className=\"p-3\">{f.velocity_ms} m/s ({Math.round(f.velocity_ms * 1.94384)} kts)</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <td className=\"p-3\">{f.true_track_deg}\302\260</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <td className=\"p-3 text-slate-400\">{f.latitude.toFixed(4)}, {f.longitude.toFixed(4)}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <td className=\"p-3 text-emerald-400 font-bold\">{f.provider}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
