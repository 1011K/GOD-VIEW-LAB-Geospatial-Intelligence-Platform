          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <td className=\"p-3 font-bold text-cyan-300\">{f.callsign || \'N/A\'}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
