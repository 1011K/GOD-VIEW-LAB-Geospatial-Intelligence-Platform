        lines {
          text: "      setSimTime(prevTime => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const nextTime = isSimPlaying "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
