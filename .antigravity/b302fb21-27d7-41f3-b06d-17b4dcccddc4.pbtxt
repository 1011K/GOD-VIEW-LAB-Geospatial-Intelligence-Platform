  view_file {
    absolute_path_uri: "file:///src/services/satellitePropagator.ts"
    end_line: 71
    content: "import * as satellite from \'satellite.js\';\nimport { SatelliteRecord } from \'../types\';\n\nexport function calculateSatellitePosition(sat: SatelliteRecord, date: Date = new Date()): SatelliteRecord[\'calculated\'] | null {\n  try {\n    if (!sat.line1 || !sat.line2) return null;\n    const satrec = satellite.twoline2satrec(sat.line1.trim(), sat.line2.trim());\n    const positionAndVelocity = satellite.propagate(satrec, date);\n    \n    const positionEci = positionAndVelocity.position;\n    const velocityEci = positionAndVelocity.velocity;\n\n    if (!positionEci || typeof positionEci === \'boolean\' || !velocityEci || typeof velocityEci === \'boolean\') {\n      return null;\n    }\n\n    const gmst = satellite.gstime(date);\n    const geodetic = satellite.eciToGeodetic(positionEci as satellite.EciVec3<number>, gmst);\n\n    const longitude = satellite.degreesLong(geodetic.longitude);\n    const latitude = satellite.degreesLat(geodetic.latitude);\n    const altitudeKm = geodetic.height;\n\n    // Calculate orbital velocity magnitude (km/s)\n    const velocityKmS = Math.sqrt(\n      Math.pow(velocityEci.x, 2) + \n      Math.pow(velocityEci.y, 2) + \n      Math.pow(velocityEci.z, 2)\n    );\n\n    // Approximate ground footprint radius using Earth radius R = 6371km and horizon geometry\n    const earthRadiusKm = 6371;\n    const horizonAngle = Math.acos(earthRadiusKm / (earthRadiusKm + Math.max(100, altitudeKm)));\n    const footprintRadiusKm = earthRadiusKm * horizonAngle;\n\n    // Mean motion from TLE line 2 (revolutions per day, columns 53-63)\n    let periodMinutes = 90;\n    try {\n      const meanMotion = parseFloat(sat.line2.substring(52, 63));\n      if (!isNaN(meanMotion) && meanMotion > 0) {\n        periodMinutes = (24 * 60) / meanMotion;\n      }\n    } catch {\n      // fallback calculation\n    }\n\n    // Inclination from TLE line 2 (columns 9-16)\n    let inclinationDeg = 51.6;\n    try {\n      const inc = parseFloat(sat.line2.substring(8, 16));\n      if (!isNaN(inc)) {\n        inclinationDeg = inc;\n      }\n    } catch {\n      // fallback\n    }\n\n    return {\n      latitude: Number(latitude.toFixed(4)),\n      longitude: Number(longitude.toFixed(4)),\n      altitudeKm: Math.round(altitudeKm),\n      velocityKmS: Number(velocityKmS.toFixed(2)),\n      footprintRadiusKm: Math.round(footprintRadiusKm),\n      periodMinutes: Number(periodMinutes.toFixed(1)),\n      inclinationDeg: Number(inclinationDeg.toFixed(2))\n    };\n  } catch (err) {\n    console.error(`Error propagating satellite ${sat.name}:`, err);\n    return null;\n  }\n}\n"
    raw_content: "import * as satellite from \'satellite.js\';\nimport { SatelliteRecord } from \'../types\';\n\nexport function calculateSatellitePosition(sat: SatelliteRecord, date: Date = new Date()): SatelliteRecord[\'calculated\'] | null {\n  try {\n    if (!sat.line1 || !sat.line2) return null;\n    const satrec = satellite.twoline2satrec(sat.line1.trim(), sat.line2.trim());\n    const positionAndVelocity = satellite.propagate(satrec, date);\n    \n    const positionEci = positionAndVelocity.position;\n    const velocityEci = positionAndVelocity.velocity;\n\n    if (!positionEci || typeof positionEci === \'boolean\' || !velocityEci || typeof velocityEci === \'boolean\') {\n      return null;\n    }\n\n    const gmst = satellite.gstime(date);\n    const geodetic = satellite.eciToGeodetic(positionEci as satellite.EciVec3<number>, gmst);\n\n    const longitude = satellite.degreesLong(geodetic.longitude);\n    const latitude = satellite.degreesLat(geodetic.latitude);\n    const altitudeKm = geodetic.height;\n\n    // Calculate orbital velocity magnitude (km/s)\n    const velocityKmS = Math.sqrt(\n      Math.pow(velocityEci.x, 2) + \n      Math.pow(velocityEci.y, 2) + \n      Math.pow(velocityEci.z, 2)\n    );\n\n    // Approximate ground footprint radius using Earth radius R = 6371km and horizon geometry\n    const earthRadiusKm = 6371;\n    const horizonAngle = Math.acos(earthRadiusKm / (earthRadiusKm + Math.max(100, altitudeKm)));\n    const footprintRadiusKm = earthRadiusKm * horizonAngle;\n\n    // Mean motion from TLE line 2 (revolutions per day, columns 53-63)\n    let periodMinutes = 90;\n    try {\n      const meanMotion = parseFloat(sat.line2.substring(52, 63));\n      if (!isNaN(meanMotion) && meanMotion > 0) {\n        periodMinutes = (24 * 60) / meanMotion;\n      }\n    } catch {\n      // fallback calculation\n    }\n\n    // Inclination from TLE line 2 (columns 9-16)\n    let inclinationDeg = 51.6;\n    try {\n      const inc = parseFloat(sat.line2.substring(8, 16));\n      if (!isNaN(inc)) {\n        inclinationDeg = inc;\n      }\n    } catch {\n      // fallback\n    }\n\n    return {\n      latitude: Number(latitude.toFixed(4)),\n      longitude: Number(longitude.toFixed(4)),\n      altitudeKm: Math.round(altitudeKm),\n      velocityKmS: Number(velocityKmS.toFixed(2)),\n      footprintRadiusKm: Math.round(footprintRadiusKm),\n      periodMinutes: Number(periodMinutes.toFixed(1)),\n      inclinationDeg: Number(inclinationDeg.toFixed(2))\n    };\n  } catch (err) {\n    console.error(`Error propagating satellite ${sat.name}:`, err);\n    return null;\n  }\n}\n"
    num_lines: 72
    num_bytes: 2525
  }
}
