        }
        lines {
          text: "          weight: 0,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fillColor: eq.magnitude >= 5.0 ? \'#ef4444\' : \'#f59e0b\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fillOpacity: 0.25"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        heatmapLayerGroup.current.addLayer(circle);"
