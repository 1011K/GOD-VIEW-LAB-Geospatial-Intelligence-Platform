          text: "    // Calculate orbital velocity magnitude (km/s)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const velocityKmS = Math.sqrt("
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      Math.pow(velocityEci.x, 2) + "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      Math.pow(velocityEci.y, 2) + "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      Math.pow(velocityEci.z, 2)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Approximate ground footprint radius using Earth radius R = 6371km and horizon geometry"
