        }
        lines {
          text: "    const earthRadiusKm = 6371;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const horizonAngle = Math.acos(earthRadiusKm / (earthRadiusKm + Math.max(100, altitudeKm)));"
